# Copy to supabase/functions/.env for `supabase functions serve`, and set the same values in
# production with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)

ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Shared secret pg_cron sends in the x-cron-secret header
CRON_SECRET=
# Random string used to sign the OAuth state parameter
OAUTH_STATE_SECRET=
# Where the dashboard is served; OAuth callbacks redirect back here
APP_URL=http://localhost:5500
# Optional: override if the public functions URL differs from SUPABASE_URL (e.g. local dev)
# OAUTH_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/connect

# Microsoft 365 / Azure (Entra ID app registration)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" for multi-tenant delegated sign-in; your tenant id is required for app-only (shared mailbox)
MS_TENANT_ID=common

# Google (OAuth client, Web application type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tuning
# MAX_EMAILS_PER_INVOCATION=12
# CLASSIFY_CONCURRENCY=3
