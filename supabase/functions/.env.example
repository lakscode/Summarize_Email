# Edge Function secrets. Copy to supabase/functions/.env, fill in, then `npm run secrets`.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# Azure portal > App registrations > your app.
#   Redirect URI (Web): https://<project-ref>.supabase.co/functions/v1/mailboxes
#   API permissions (Microsoft Graph, delegated): offline_access, User.Read, Mail.Read, Mail.Send
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" accepts any work/school or personal account; use your tenant ID to restrict to your org.
MS_TENANT_ID=common

# Google Cloud console > APIs & Services (optional; enables "Add Gmail mailbox").
#   Enable the Gmail API. OAuth consent screen scopes: gmail.readonly, gmail.send.
#   Credentials > OAuth client ID (Web application), Authorized redirect URI:
#   https://<project-ref>.supabase.co/functions/v1/mailboxes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key used to classify AP emails (console.anthropic.com).
ANTHROPIC_API_KEY=

# Random string used to sign the OAuth state, e.g. `openssl rand -hex 32`.
OAUTH_STATE_SECRET=

# Where the UI is hosted; users are sent back to <APP_URL>/dashboard after connecting.
APP_URL=https://<your-app>.vercel.app
